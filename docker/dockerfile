FROM ubuntu:24.04

# Prevent interactive prompts from apt during build
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# 1. Install system Python, venv, and pre-compiled lgpio libraries via apt
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-lgpio \
    && rm -rf /var/lib/apt/lists/*

# 2. Create and activate a virtual environment to manage Python packages cleanly
RUN python3 -m venv --system-site-packages /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 3. Bake the board configuration variable directly into the image
ENV BLINKA_FORCEBOARD=RASPBERRY_PI_4B
ENV RPI_LGPIO_REVISION=d03114
ENV IOT_PUBLISH_INTERVAL_S=300

# 4. Copy and install remaining Python dependencies (like Adafruit CircuitPython DHT)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copy the rest of your application code
COPY dht22_read.py . 
COPY /certs/ /app/certs/

# 6. Define the runtime command
CMD ["python3", "dht22_read.py"]