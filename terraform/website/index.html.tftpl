<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edge IoT Dashboard</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background: #0f1419;
      color: #e6e8eb;
    }
    header, main, footer { max-width: 1100px; margin: 0 auto; padding: 1rem 1.25rem; }
    h1 { margin: 0 0 0.25rem; font-size: 1.5rem; }
    .subtitle { margin: 0; color: #8b95a1; font-size: 0.95rem; }
    .card {
      background: #1a2028;
      border: 1px solid #2a323c;
      border-radius: 8px;
      overflow: hidden;
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid #2a323c;
    }
    .card-header h2 { margin: 0; font-size: 1.05rem; }
    a { color: #5aa9ff; text-decoration: none; }
    a:hover { text-decoration: underline; }
    iframe { display: block; width: 100%; height: 60vh; min-height: 360px; border: 0; }
    .placeholder { padding: 2rem 1rem; color: #8b95a1; text-align: center; }
    footer { color: #8b95a1; font-size: 0.85rem; text-align: center; }
  </style>
</head>
<body>
  <header>
    <h1>DHT22 Telemetry</h1>
    <p class="subtitle">Temperature and humidity from the Raspberry Pi sensor.</p>
  </header>

  <main>
    <section class="card">
      <div class="card-header">
        <h2>Temperature &amp; Humidity</h2>
%{ if grafana_embed_url != "" ~}
        <a href="${grafana_embed_url}" target="_blank" rel="noopener noreferrer">Open in Grafana</a>
%{ endif ~}
      </div>
%{ if grafana_embed_url != "" ~}
      <iframe src="${grafana_embed_url}" title="Grafana graph" loading="lazy"></iframe>
%{ else ~}
      <p class="placeholder">No Grafana panel configured. Set the <code>grafana_embed_url</code> Terraform variable to show the graph here.</p>
%{ endif ~}
    </section>
  </main>

  <footer>Data stored in DynamoDB, visualised with Grafana.</footer>
</body>
</html>
