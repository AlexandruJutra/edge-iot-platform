<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edge IoT Dashboard</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background: #0f1419;
      color: #e6e8eb;
    }
    header, main, footer { max-width: 1100px; margin: 0 auto; padding: 1rem 1.25rem; }
    h1 { margin: 0 0 0.25rem; font-size: 1.5rem; }
    .subtitle { margin: 0; color: #8b95a1; font-size: 0.95rem; }
    .card {
      background: #1a2028;
      border: 1px solid #2a323c;
      border-radius: 8px;
      overflow: hidden;
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid #2a323c;
    }
    .card-header h2 { margin: 0; font-size: 1.05rem; }
    a { color: #5aa9ff; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .grafana-button {
      display: inline-block;
      padding: 0.55rem 0.8rem;
      border-radius: 4px;
      background: #5aa9ff;
      color: #0f1419;
      font-weight: 600;
    }
    .grafana-button:hover { background: #83bdff; text-decoration: none; }
    .readings { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: #2a323c; }
    .reading { padding: 1.25rem; background: #1a2028; }
    .reading-label { margin: 0 0 0.5rem; color: #8b95a1; font-size: 0.9rem; }
    .reading-value { margin: 0; font-size: 2rem; font-variant-numeric: tabular-nums; }
    .reading-status { padding: 0 1rem 1rem; margin: 0; color: #8b95a1; }
    .placeholder { padding: 2rem 1rem; color: #8b95a1; text-align: center; }
    footer { color: #8b95a1; font-size: 0.85rem; text-align: center; }
    @media (max-width: 520px) {
      .card-header { align-items: flex-start; gap: 1rem; flex-direction: column; }
      .readings { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <header>
    <h1>DHT22 Telemetry</h1>
    <p class="subtitle">Temperature and humidity from the Raspberry Pi sensor.</p>
  </header>

  <main>
    <section class="card">
      <div class="card-header">
        <h2>Temperature &amp; Humidity</h2>
%{ if grafana_embed_url != "" ~}
        <a class="grafana-button" href="${grafana_embed_url}" target="_blank" rel="noopener noreferrer">Open in Grafana</a>
%{ endif ~}
      </div>
      <div class="readings" aria-live="polite">
        <section class="reading">
          <p class="reading-label">Temperature</p>
          <p class="reading-value"><span id="temperature">--</span> &deg;C</p>
        </section>
        <section class="reading">
          <p class="reading-label">Humidity</p>
          <p class="reading-value"><span id="humidity">--</span> %</p>
        </section>
      </div>
      <p class="reading-status" id="reading-status">Loading latest reading...</p>
    </section>
  </main>

  <footer>Data stored in DynamoDB, visualised with Grafana.</footer>
  <script>
    fetch('${telemetry_api_url}', { cache: 'no-store' })
      .then(response => {
        if (!response.ok) throw new Error('Telemetry request failed');
        return response.json();
      })
      .then(readings => {
        const latest = readings
          .filter(reading => Number.isFinite(Date.parse(reading.timestamp)))
          .sort((first, second) => Date.parse(second.timestamp) - Date.parse(first.timestamp))[0];
        if (!latest) throw new Error('No telemetry readings found');
        document.getElementById('temperature').textContent = latest.temperature_c;
        document.getElementById('humidity').textContent = latest.humidity;
        document.getElementById('reading-status').textContent =
          'Latest reading: ' + new Date(latest.timestamp).toLocaleString();
      })
      .catch(() => {
        document.getElementById('reading-status').textContent = 'Unable to load the latest reading.';
      });
  </script>
</body>
</html>
